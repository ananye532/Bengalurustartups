# Copy to .env and load it however you prefer (e.g. `node --env-file=.env server/index.js`).

# Required when NODE_ENV=production. In development a random secret is generated
# per boot, which simply invalidates tokens on restart.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite file. Defaults to ./data/apex.db
DATABASE_FILE=./data/apex.db

PORT=3000
HOST=0.0.0.0
